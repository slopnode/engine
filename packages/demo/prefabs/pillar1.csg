(brush-box
  (id "brush-1")
  (mins 0 0 -1)
  (maxs 1 5 0)
  (material "engine/dev/dev-grey-128")
  (role "detail")
)

(brush-convex
  (id "brush-2")
  (role "detail")
  (material "engine/dev/dev-grey-128")
  (faces
    (face
      (id "brush-2/top")
      (verts (v 0 6 -1.5) (v 0 6 0.5) (v 1 6 0.5) (v 1 6 -1.5)))
    (face
      (id "brush-2/bottom")
      (verts (v 0 5 -1) (v 1 5 -1) (v 1 5 0) (v 0 5 0)))
    (face
      (id "brush-2/north")
      (verts (v 0 5 -1) (v 0 6 -1.5) (v 1 6 -1.5) (v 1 5 -1)))
    (face
      (id "brush-2/south")
      (verts (v 0 5 0) (v 1 5 0) (v 1 6 0.5) (v 0 6 0.5)))
    (face
      (id "brush-2/east")
      (verts (v 1 5 0) (v 1 5 -1) (v 1 6 -1.5) (v 1 6 0.5)))
    (face
      (id "brush-2/west")
      (verts (v 0 5 -1) (v 0 5 0) (v 0 6 0.5) (v 0 6 -1.5)))
  )
)

