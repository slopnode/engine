(define (fn sig . desc)
  (row (code sig) (apply cell desc)))

(define (fn-table . rows)
  (table :class "fn-table"
    (header "Form" "Description")
    rows))

(define (node-row form . desc)
  (row (code form) (apply cell desc)))

(define (node-table . rows)
  (table :class "node-table"
    (header "Node" "Renders as")
    rows))
