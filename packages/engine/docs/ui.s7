(require-doc "lib")

(page "ui" "ui.s7"
  (p "A declarative wrapper over the " (code "ui-*") " ImGui bindings. A screen is declared "
     "once with " (ref "define-screen") " and a builder thunk, built on first render into a "
     "tree of nodes, and walked every frame by " (ref "ui-screen-render") ". Only "
     (code "dynamic") " and " (code "dynamic-text") " nodes re-evaluate anything per frame.")

  (section "Screens"
    (fn-table
      (fn "(define-screen name builder)"
          "Registers a screen under the symbol " (code "name") ". " (code "builder")
          " is a thunk returning the root node; it runs once, on first use.")
      (fn "(ui-screen-render name)"
          "Builds the screen if needed and renders it. Call from a " (code "ui") "-scope hook "
          "such as " (ref "draw-pause-menu") " or " (ref "draw-modals") ".")
      (fn "(ui-screen-node name id)"
          "The node with " (code "id") " in the built screen. Raises when unknown.")
      (fn "(ui-get name id key)" "A property of that node.")
      (fn "(ui-set! name id key value)" "Sets a property of that node in place.")
      (fn "(ui-screen-append! name node)"
          "Adds " (code "node") " as the last child of the root and reindexes ids."))
    (code 'scheme "
      (define-screen 'pause-menu
        (lambda ()
          (vbox
            (button \"pause-resume\" \"Resume\" close-pause-menu)
            (when-visible? playing?
              (button \"pause-save\" \"Save Game\" open-save-game-menu))
            (separator)
            (dynamic-text (lambda () (string-append \"Map: \" (current-map)))))))

      (define (draw-pause-menu) (ui-screen-render 'pause-menu))"))

  (section "Nodes"
    (p "Every constructor returns a node. Containers take their children as rest arguments. "
       "An " (code "id") " is the string used by " (code "ui-screen-node") ", "
       (code "ui-get") " and " (code "ui-set!") "; nodes without one cannot be addressed "
       "after the build.")
    (section "Containers"
      (node-table
        (node-row "(window title child...)" (ref "ui-begin") " / " (ref "ui-end") " window.")
        (node-row "(modal title width height child...)"
                  "A centered window of fixed size, for dialogs.")
        (node-row "(vbox child...)" "Children in order, one per line.")
        (node-row "(hbox child...)" "Children on one line via " (ref "ui-same-line") ".")
        (node-row "(indent child...)" "Children indented one level.")
        (node-row "(ui-child id height child...)" "A scrolling child region of the given height.")
        (node-row "(panel id height child...)" "A framed panel of the given height.")
        (node-row "(menu id label child...)" "A submenu, for use inside a menu bar hook.")))
    (section "Text"
      (node-table
        (node-row "(text label)" (ref "ui-text") ".")
        (node-row "(heading label)" "Larger text.")
        (node-row "(label-dim label)" "Dimmed text.")
        (node-row "(mono-text label)" "Monospace text.")
        (node-row "(dynamic-text getter)"
                  "Text from calling " (code "getter") " every frame.")
        (node-row "(separator)" (ref "ui-separator") ".")
        (node-row "(spacer [height])" "Vertical space.")))
    (section "Controls"
      (p "Each control takes an " (code "id") ", a label, and the getters and callbacks it "
         "needs. Getters are thunks evaluated every frame; callbacks run when the control "
         "fires. After rendering, a clickable node's " (code "clicked?") " property holds "
         "whether it fired this frame.")
      (node-table
        (node-row "(button id label on-click)" (ref "ui-button") ".")
        (node-row "(primary-button id label on-click)" "An emphasized button.")
        (node-row "(menu-item id label enabled-getter on-click)" (ref "ui-menu-item") ".")
        (node-row "(menu-check id label checked-getter on-toggle)"
                  (ref "ui-menu-check") "; " (code "on-toggle") " receives the new value.")
        (node-row "(selectable id label selected-getter on-click)" (ref "ui-selectable") ".")
        (node-row "(input-text id initial on-change)"
                  "A text field. " (code "on-change") " receives the new string and the node "
                  "keeps it in its " (code "value") " property.")
        (node-row "(combo id preview-getter item...)"
                  "A dropdown whose closed label comes from " (code "preview-getter") ".")
        (node-row "(combo-item label selected-getter on-click)" "One dropdown entry.")))
    (section "Visibility and dynamic content"
      (node-table
        (node-row "(when-visible? getter node)"
                  "Returns " (code "node") " marked so it is skipped while " (code "getter")
                  " returns " (code "#f") ".")
        (node-row "(dynamic builder)"
                  "Calls " (code "builder") " every frame and renders the list of nodes it "
                  "returns. Use for rows whose count changes."))
      (warning "A " (code "dynamic") " builder runs every frame, so keep it cheap and prefer "
               (code "when-visible?") " when only visibility changes.")))

  (section "Addressing nodes after the build"
    (p "Properties set by constructors (" (code "label") ", " (code "on-click") ", "
       (code "value") " and so on) can be read and replaced later:")
    (code 'scheme "
      (ui-set! 'pause-menu \"pause-save\" 'label \"Save Game (slot 2)\")
      (ui-get 'pause-menu \"pause-save\" 'clicked?)")
    (p "The tree is not rebuilt by these calls. " (code "ui-screen-append!") " is the only "
       "structural change; anything larger means a new screen.")))
