(require-doc "lib")

(define (shader-table . rows)
  (table :class "shader-table"
    (header "Shader" "Used by" "Uniforms")
    rows))

(define (shader name used . uniforms)
  (row (code name) used (apply cell uniforms)))

(page "shaders" "Shaders"
  (p "Every GLSL file the renderer and the tools load lives under " (code "shaders/")
     " in this package. The " (code "Shader") " asset kind resolves a virtual path such as "
     (code "default/post_vert") " to " (code "shaders/default/post_vert.glsl") ", and a game "
     "can replace any of them by shipping a file at the same path. All scene and screen "
     "shaders are GLSL 330; the two radiosity compute shaders need GLSL 430.")

  (section "Scene"
    (p "Loaded once by the engine and bound while drawing the world, sprites, the viewmodel "
       "and the sky. The vertex inputs and the " (code "mvp") ", " (code "matModel") ", "
       (code "matNormal") ", " (code "texture0") " and " (code "colDiffuse") " uniforms "
       "follow raylib's conventions.")
    (shader-table
      (shader "default/lightmap_vert, default/lightmap_frag"
              "World brushes. Every material whose shader field is the default."
              (code "texture1") " is the baked lightmap atlas, decoded from RGBE when "
              (code "lightmapEncoding") " says so. " (code "useLightmap") ", "
              (code "solidLit") " and " (code "emissionPower") " select the lit, unlit and "
              "emissive paths. " (code "dynLightCount") " with the " (code "dynLight*")
              " arrays carry the dynamic light overlay, and " (code "dynShadowVp") " with "
              (code "dynShadowMaps") " its shadow maps.")
      (shader "default/sprite_billboard_vert, default/sprite_billboard_frag"
              "World sprites and first-person sprites."
              (code "albedoRect") " and " (code "atlasSize") " pick the frame out of the "
              "sprite atlas. " (code "texture1") " is the brightmap when "
              (code "useBrightmap") " is set. " (code "texture2") " is the part mask, and "
              (code "hiddenPartsMask") " hides parts by bit, which is what "
              (ref "sprite-hide-part!") " drives.")
      (shader "default/viewmodel_vert, default/viewmodel_frag"
              "Geometry attached to first-person sockets."
              (code "probeRgb") " and " (code "ambient") " come from the lighting probe "
              "at the eye. " (code "keyDir") ", " (code "keyStrength") " and "
              (code "rimStrength") " add a key light and a rim so the weapon reads against "
              "the scene. See " (ref "fp-set-shading") ".")
      (shader "default/skinning_vert, default/skinning_frag"
              "Skeletal geometry."
              (code "boneMatrices") " holds up to 128 bone transforms, indexed by the "
              (code "vertexBoneIndices") " and " (code "vertexBoneWeights") " attributes.")
      (shader "default/skybox_vert, default/skybox_frag"
              "The sky drawn behind the world."
              (code "matProjection") " and " (code "matViewRot") " rebuild a view direction "
              "per pixel.")
      (shader "default/sky_face_vert, default/sky_face_frag"
              "Brush faces whose material has the sky flag."
              (code "cameraPos") " gives the direction from the eye through the face.")
      (shader "default/sky_sample"
              "Included by both sky shaders."
              "Not a program on its own. The engine replaces the line "
              (code "#include \"SKY_SAMPLE\"") " with this file's text. " (code "skyMode")
              " selects a solid color, a gradient from " (code "skyGradientColors") ", a "
              (code "skyCube") " map or a " (code "skyCylinder") " texture.")
      (shader "default/shadow_depth_vert, default/shadow_depth_frag"
              "Shadow map passes for dynamic lights."
              "Writes depth only. " (code "useAlphaClip") " discards texels under half "
              "alpha so masked sprites cast cut-out shadows.")))

  (section "Screen passes"
    (p "Fullscreen passes share one vertex shader, " (code "default/post_vert") ". Each "
       "fragment shader receives the previous image as " (code "texture0") " with "
       (code "fragTexCoord") " across the screen.")
    (shader-table
      (shader "default/post_vert"
              "Every post-process and compositing pass."
              "Passes the quad through with " (code "fragTexCoord") " and "
              (code "fragColor") ".")
      (shader "default/underwater_frag"
              "Applied by the engine while the player is submerged."
              (code "amount") " fades the effect in and out. " (code "tint") ", "
              (code "wobble") " and " (code "vignette") " shape it, " (code "time") " drives "
              "the ripple and " (code "resolution") " keeps the vignette round.")
      (shader "default/scope_mask_frag"
              (cell (ref "hud-draw-eye") " with a mask texture.")
              "Composites the secondary eye through " (code "maskTexture") ".")
      (shader "default/loading_crossfade_frag"
              "The map load transition."
              "Blends " (code "snapshotTexture") " of the previous frame into the new "
              "scene by " (code "mixT") ".")))

  (section "Tools"
    (shader-table
      (shader "tools/grid_vert, tools/grid_frag"
              "slopmap's preview grid."
              (code "gridSize") ", " (code "planeAxis") " and " (code "fadeRadius")
              " around " (code "cameraPos") ", with " (code "minorColor") " and "
              (code "majorColor") " for the two line weights.")
      (shader "tools/rad_direct_comp"
              "sloprad direct lighting."
              "A compute shader over every luxel gathering point, spot, sun and emissive "
              "face contributions with occlusion raycasts against the BSP.")
      (shader "tools/rad_bounce_comp"
              "sloprad bounce lighting."
              "A compute shader for the indirect passes. When either radiosity shader is "
              "missing sloprad warns and falls back to the CPU path.")))

  (section "Writing a post-process pass"
    (p "A game adds its own screen effect by shipping a fragment shader and pushing it with "
       (ref "post-push-shader") ". The engine compiles it against "
       (code "default/post_vert") ", so the shader only needs the inputs that vertex shader "
       "provides.")
    (code 'glsl "
      #version 330

      in vec2 fragTexCoord;
      in vec4 fragColor;

      uniform sampler2D texture0;
      uniform vec4 colDiffuse;
      uniform float strength;

      out vec4 finalColor;

      void main()
      {
          vec4 scene = texture(texture0, fragTexCoord);
          vec3 red = mix(scene.rgb, vec3(1.0, 0.1, 0.1), strength);
          finalColor = vec4(red, scene.a) * colDiffuse * fragColor;
      }")
    (p "Saved as " (code "shaders/effects/hurt_frag.glsl") " in the game package, it is "
       "pushed onto the scene stack and driven from Scheme:")
    (code 'scheme "
      (define *hurt-pass* (post-push-shader \"effects/hurt_frag\" 'scene))

      (define (on-player-hurt amount)
        (post-set-float *hurt-pass* \"strength\" (clamp01 amount)))")
    (p "The target is " (code "'scene") ", " (code "'hud") " or " (code "'both") ". "
       (ref "post-set-float") ", " (ref "post-set-vec2") ", " (ref "post-set-vec3") " and "
       (ref "post-set-vec4") " update uniforms on a pass by its handle, "
       (ref "post-set-enabled") " toggles it, and " (ref "post-remove-shader") " or "
       (ref "post-clear-shaders") " take it down.")
    (note "Each pushed pass is a full extra fullscreen draw. Keep the stack short and "
          "disable a pass with " (code "post-set-enabled") " rather than pushing it again.")))
