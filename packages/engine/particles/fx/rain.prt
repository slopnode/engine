(particle-system
  (duration 0)
  (loop #t)
  (emitter "rain"
    (unlit #t)
    (sim cpu)
    (sprite "fx/rain")
    (billboard face)
    (max-particles 4200)
    (rate 4200)
    (burst 4)
    (lifetime 1.2 2.2)
    (speed 0.2 0.8)
    (size 1 1)
    (color 0.5 1 0.5 0.8)
    (gravity 28)
    (space world)
    (shape box 50 0.4 50)
    (size-over-life 1.0 1.0)
    (alpha-over-life 1 0.3)
    (bounce 0)
    (max-bounces 0)
    (die-on-hit #f)))
