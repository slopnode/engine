(particle-system
  (duration 0)
  (loop #t)
  (emitter "rain"
    (unlit #t)
    (sim gpu)
    (sprite "fx/rain")
    (billboard face)
    (max-particles 1200)
    (rate 1200)
    (burst 4)
    (lifetime 1.2 2.2)
    (speed 0.05 0.2)
    (size 0.08 0.18)
    (color 1 1 1 0.7)
    (gravity 28)
    (space world)
    (shape box 8 0.4 30)
    (size-over-life 1.0 1.0)
    (alpha-over-life 1 0.3)
    (bounce 0)
    (max-bounces 0)
    (die-on-hit #t)))
