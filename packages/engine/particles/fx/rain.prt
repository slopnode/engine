(particle-system
  (duration 0)
  (loop #t)
  (emitter "rain"
    (unlit #t)
    (sim cpu)
    (sprite "fx/rain")
    (billboard face)
    (blend alpha)
    (max-particles 8192)
    (rate 3200)
    (burst 1200)
    (lifetime 1.2 2.2)
    (speed 0.05 0.2)
    (size 0.08 0.18)
    (color 0 0 0.9 1)
    (gravity 28)
    (space world)
    (shape box 4 0.4 4)
    (size-over-life 1.0 1.0)
    (alpha-over-life 3 3)
    (bounce 0)
    (max-bounces 0)
    (die-on-hit #t)))
