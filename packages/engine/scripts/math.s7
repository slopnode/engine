"Scalar helpers and list-backed vectors. A vector is a plain list of numbers, the same shape the engine bindings use for positions and directions, so a value from `actor-pos` can go straight into `Vector3-sub`."

(define (clamp x lo hi)
  "X limited to the range LO to HI.
   @param x real?
   @param lo real?
   @param hi real?
   @return real?"
  (cond
    ((< x lo) lo)
    ((> x hi) hi)
    (else x)))

(define (clamp01 x)
  "X limited to 0 to 1.
   @param x real?
   @return real?"
  (clamp x 0 1))

(define (lerp a b tt)
  "Linear interpolation from A to B by TT.
   @param a real?
   @param b real?
   @param tt real? 0 gives a, 1 gives b
   @return real?"
  (+ a (* (- b a) tt)))

(define-macro (Vector2 x y)
  "A two-component vector as a list of X and Y."
  `(list ,x ,y))
(define-macro (Vector3 x y z)
  "A three-component vector as a list of X, Y and Z."
  `(list ,x ,y ,z))
(define-macro (Vector4 x y z w)
  "A four-component vector as a list of X, Y, Z and W."
  `(list ,x ,y ,z ,w))

(define (Vector2? v)
  "#t when V is a list of exactly two numbers.
   @param v any?
   @return boolean?"
  (and (list? v) (= (length v) 2)
       (number? (list-ref v 0)) (number? (list-ref v 1))))

(define (Vector3? v)
  "#t when V is a list of exactly three numbers.
   @param v any?
   @return boolean?"
  (and (list? v) (= (length v) 3)
       (number? (list-ref v 0)) (number? (list-ref v 1)) (number? (list-ref v 2))))

(define (Vector4? v)
  "#t when V is a list of exactly four numbers.
   @param v any?
   @return boolean?"
  (and (list? v) (= (length v) 4)
       (number? (list-ref v 0)) (number? (list-ref v 1))
       (number? (list-ref v 2)) (number? (list-ref v 3))))

(define (Vector2-add a b)
  "Componentwise sum of A and B."
  (list (+ (list-ref a 0) (list-ref b 0))
        (+ (list-ref a 1) (list-ref b 1))))

(define (Vector2-sub a b)
  "Componentwise difference of A and B."
  (list (- (list-ref a 0) (list-ref b 0))
        (- (list-ref a 1) (list-ref b 1))))

(define (Vector2-scale v s)
  "V with every component multiplied by S."
  (list (* (list-ref v 0) s)
        (* (list-ref v 1) s)))

(define (Vector2-negate v)
  "V with every component negated."
  (list (- (list-ref v 0)) (- (list-ref v 1))))

(define (Vector2-dot a b)
  "Dot product of A and B."
  (+ (* (list-ref a 0) (list-ref b 0))
     (* (list-ref a 1) (list-ref b 1))))

(define (Vector2-cross a b)
  "The scalar z of the 3D cross product of A and B, positive when B is counterclockwise from A."
  (- (* (list-ref a 0) (list-ref b 1))
     (* (list-ref a 1) (list-ref b 0))))

(define (Vector2-length v)
  "Euclidean length of V."
  (sqrt (Vector2-dot v v)))

(define (Vector2-normalize v)
  "Unit vector in the direction of V, or the zero vector when its length is 0."
  (let ((len (Vector2-length v)))
    (if (= len 0) (Vector2 0 0) (Vector2-scale v (/ 1 len)))))

(define (Vector2-lerp a b tt)
  "Linear interpolation from A to B by TT."
  (Vector2-add a (Vector2-scale (Vector2-sub b a) tt)))

(define (Vector3-add a b)
  "Componentwise sum of A and B."
  (list (+ (list-ref a 0) (list-ref b 0))
        (+ (list-ref a 1) (list-ref b 1))
        (+ (list-ref a 2) (list-ref b 2))))

(define (Vector3-sub a b)
  "Componentwise difference of A and B."
  (list (- (list-ref a 0) (list-ref b 0))
        (- (list-ref a 1) (list-ref b 1))
        (- (list-ref a 2) (list-ref b 2))))

(define (Vector3-scale v s)
  "V with every component multiplied by S."
  (list (* (list-ref v 0) s)
        (* (list-ref v 1) s)
        (* (list-ref v 2) s)))

(define (Vector3-negate v)
  "V with every component negated."
  (list (- (list-ref v 0)) (- (list-ref v 1)) (- (list-ref v 2))))

(define (Vector3-dot a b)
  "Dot product of A and B."
  (+ (* (list-ref a 0) (list-ref b 0))
     (* (list-ref a 1) (list-ref b 1))
     (* (list-ref a 2) (list-ref b 2))))

(define (Vector3-cross a b)
  "Cross product of A and B."
  (list (- (* (list-ref a 1) (list-ref b 2)) (* (list-ref a 2) (list-ref b 1)))
        (- (* (list-ref a 2) (list-ref b 0)) (* (list-ref a 0) (list-ref b 2)))
        (- (* (list-ref a 0) (list-ref b 1)) (* (list-ref a 1) (list-ref b 0)))))

(define (Vector3-length v)
  "Euclidean length of V."
  (sqrt (Vector3-dot v v)))

(define (Vector3-normalize v)
  "Unit vector in the direction of V, or the zero vector when its length is 0."
  (let ((len (Vector3-length v)))
    (if (= len 0) (Vector3 0 0 0) (Vector3-scale v (/ 1 len)))))

(define (Vector3-lerp a b tt)
  "Linear interpolation from A to B by TT."
  (Vector3-add a (Vector3-scale (Vector3-sub b a) tt)))

(define (Vector4-add a b)
  "Componentwise sum of A and B."
  (list (+ (list-ref a 0) (list-ref b 0))
        (+ (list-ref a 1) (list-ref b 1))
        (+ (list-ref a 2) (list-ref b 2))
        (+ (list-ref a 3) (list-ref b 3))))

(define (Vector4-sub a b)
  "Componentwise difference of A and B."
  (list (- (list-ref a 0) (list-ref b 0))
        (- (list-ref a 1) (list-ref b 1))
        (- (list-ref a 2) (list-ref b 2))
        (- (list-ref a 3) (list-ref b 3))))

(define (Vector4-scale v s)
  "V with every component multiplied by S."
  (list (* (list-ref v 0) s)
        (* (list-ref v 1) s)
        (* (list-ref v 2) s)
        (* (list-ref v 3) s)))

(define (Vector4-negate v)
  "V with every component negated."
  (list (- (list-ref v 0)) (- (list-ref v 1)) (- (list-ref v 2)) (- (list-ref v 3))))

(define (Vector4-dot a b)
  "Dot product of A and B."
  (+ (* (list-ref a 0) (list-ref b 0))
     (* (list-ref a 1) (list-ref b 1))
     (* (list-ref a 2) (list-ref b 2))
     (* (list-ref a 3) (list-ref b 3))))

(define (Vector4-length v)
  "Euclidean length of V."
  (sqrt (Vector4-dot v v)))

(define (Vector4-normalize v)
  "Unit vector in the direction of V, or the zero vector when its length is 0."
  (let ((len (Vector4-length v)))
    (if (= len 0) (Vector4 0 0 0 0) (Vector4-scale v (/ 1 len)))))

(define (Vector4-lerp a b tt)
  "Linear interpolation from A to B by TT."
  (Vector4-add a (Vector4-scale (Vector4-sub b a) tt)))
