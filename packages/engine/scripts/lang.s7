(define (require path)
  (let ((pkg (current-package-id)))
    (if (not pkg)
        (error 'require "require: no current package context (only usable while a package script/data file is loading)")
        (if (not (package-load-script pkg path))
            (error 'require "require: no such script \"~A\" in package \"~A\"" path pkg)
            #t))))

(define (require-data path)
  (let ((pkg (current-package-id)))
    (if (not pkg)
        (error 'require-data "require-data: no current package context (only usable while a package script/data file is loading)")
        (if (not (package-load-data pkg path))
            (error 'require-data "require-data: no such data file \"~A\" in package \"~A\"" path pkg)
            #t))))

(define-macro (first lst) `(list-ref ,lst 0))
(define-macro (second lst) `(list-ref ,lst 1))
(define-macro (third lst) `(list-ref ,lst 2))
(define-macro (fourth lst) `(list-ref ,lst 3))
(define-macro (fifth lst) `(list-ref ,lst 4))

(define-macro (Vector2 x y) `(list ,x ,y))
(define-macro (Vector3 x y z) `(list ,x ,y ,z))
(define-macro (Vector4 x y z w) `(list ,x ,y ,z ,w))

(define-macro (Vector2? v)
  (let ((tmp (gensym)))
    `(let ((,tmp ,v))
       (and (list? ,tmp) (= (length ,tmp) 2)
            (number? (list-ref ,tmp 0)) (number? (list-ref ,tmp 1))))))

(define-macro (Vector3? v)
  (let ((tmp (gensym)))
    `(let ((,tmp ,v))
       (and (list? ,tmp) (= (length ,tmp) 3)
            (number? (list-ref ,tmp 0)) (number? (list-ref ,tmp 1)) (number? (list-ref ,tmp 2))))))

(define-macro (Vector4? v)
  (let ((tmp (gensym)))
    `(let ((,tmp ,v))
       (and (list? ,tmp) (= (length ,tmp) 4)
            (number? (list-ref ,tmp 0)) (number? (list-ref ,tmp 1))
            (number? (list-ref ,tmp 2)) (number? (list-ref ,tmp 3))))))

(define-macro (Vector2-add a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (list (+ (list-ref ,ta 0) (list-ref ,tb 0))
             (+ (list-ref ,ta 1) (list-ref ,tb 1))))))

(define-macro (Vector2-sub a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (list (- (list-ref ,ta 0) (list-ref ,tb 0))
             (- (list-ref ,ta 1) (list-ref ,tb 1))))))

(define-macro (Vector2-scale v s)
  (let ((tv (gensym)) (ts (gensym)))
    `(let ((,tv ,v) (,ts ,s))
       (list (* (list-ref ,tv 0) ,ts)
             (* (list-ref ,tv 1) ,ts)))))

(define-macro (Vector2-negate v)
  (let ((tv (gensym)))
    `(let ((,tv ,v))
       (list (- (list-ref ,tv 0)) (- (list-ref ,tv 1))))))

(define-macro (Vector2-dot a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (+ (* (list-ref ,ta 0) (list-ref ,tb 0))
          (* (list-ref ,ta 1) (list-ref ,tb 1))))))

(define-macro (Vector2-cross a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (- (* (list-ref ,ta 0) (list-ref ,tb 1))
          (* (list-ref ,ta 1) (list-ref ,tb 0))))))

(define (Vector2-length v) (sqrt (Vector2-dot v v)))

(define (Vector2-normalize v)
  (let ((len (Vector2-length v)))
    (if (= len 0) (Vector2 0 0) (Vector2-scale v (/ 1 len)))))

(define (Vector2-lerp a b tt)
  (Vector2-add a (Vector2-scale (Vector2-sub b a) tt)))

(define-macro (Vector3-add a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (list (+ (list-ref ,ta 0) (list-ref ,tb 0))
             (+ (list-ref ,ta 1) (list-ref ,tb 1))
             (+ (list-ref ,ta 2) (list-ref ,tb 2))))))

(define-macro (Vector3-sub a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (list (- (list-ref ,ta 0) (list-ref ,tb 0))
             (- (list-ref ,ta 1) (list-ref ,tb 1))
             (- (list-ref ,ta 2) (list-ref ,tb 2))))))

(define-macro (Vector3-scale v s)
  (let ((tv (gensym)) (ts (gensym)))
    `(let ((,tv ,v) (,ts ,s))
       (list (* (list-ref ,tv 0) ,ts)
             (* (list-ref ,tv 1) ,ts)
             (* (list-ref ,tv 2) ,ts)))))

(define-macro (Vector3-negate v)
  (let ((tv (gensym)))
    `(let ((,tv ,v))
       (list (- (list-ref ,tv 0)) (- (list-ref ,tv 1)) (- (list-ref ,tv 2))))))

(define-macro (Vector3-dot a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (+ (* (list-ref ,ta 0) (list-ref ,tb 0))
          (* (list-ref ,ta 1) (list-ref ,tb 1))
          (* (list-ref ,ta 2) (list-ref ,tb 2))))))

(define-macro (Vector3-cross a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (list (- (* (list-ref ,ta 1) (list-ref ,tb 2)) (* (list-ref ,ta 2) (list-ref ,tb 1)))
             (- (* (list-ref ,ta 2) (list-ref ,tb 0)) (* (list-ref ,ta 0) (list-ref ,tb 2)))
             (- (* (list-ref ,ta 0) (list-ref ,tb 1)) (* (list-ref ,ta 1) (list-ref ,tb 0)))))))

(define (Vector3-length v) (sqrt (Vector3-dot v v)))

(define (Vector3-normalize v)
  (let ((len (Vector3-length v)))
    (if (= len 0) (Vector3 0 0 0) (Vector3-scale v (/ 1 len)))))

(define (Vector3-lerp a b tt)
  (Vector3-add a (Vector3-scale (Vector3-sub b a) tt)))

(define-macro (Vector4-add a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (list (+ (list-ref ,ta 0) (list-ref ,tb 0))
             (+ (list-ref ,ta 1) (list-ref ,tb 1))
             (+ (list-ref ,ta 2) (list-ref ,tb 2))
             (+ (list-ref ,ta 3) (list-ref ,tb 3))))))

(define-macro (Vector4-sub a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (list (- (list-ref ,ta 0) (list-ref ,tb 0))
             (- (list-ref ,ta 1) (list-ref ,tb 1))
             (- (list-ref ,ta 2) (list-ref ,tb 2))
             (- (list-ref ,ta 3) (list-ref ,tb 3))))))

(define-macro (Vector4-scale v s)
  (let ((tv (gensym)) (ts (gensym)))
    `(let ((,tv ,v) (,ts ,s))
       (list (* (list-ref ,tv 0) ,ts)
             (* (list-ref ,tv 1) ,ts)
             (* (list-ref ,tv 2) ,ts)
             (* (list-ref ,tv 3) ,ts)))))

(define-macro (Vector4-negate v)
  (let ((tv (gensym)))
    `(let ((,tv ,v))
       (list (- (list-ref ,tv 0)) (- (list-ref ,tv 1)) (- (list-ref ,tv 2)) (- (list-ref ,tv 3))))))

(define-macro (Vector4-dot a b)
  (let ((ta (gensym)) (tb (gensym)))
    `(let ((,ta ,a) (,tb ,b))
       (+ (* (list-ref ,ta 0) (list-ref ,tb 0))
          (* (list-ref ,ta 1) (list-ref ,tb 1))
          (* (list-ref ,ta 2) (list-ref ,tb 2))
          (* (list-ref ,ta 3) (list-ref ,tb 3))))))

(define (Vector4-length v) (sqrt (Vector4-dot v v)))

(define (Vector4-normalize v)
  (let ((len (Vector4-length v)))
    (if (= len 0) (Vector4 0 0 0 0) (Vector4-scale v (/ 1 len)))))

(define (Vector4-lerp a b tt)
  (Vector4-add a (Vector4-scale (Vector4-sub b a) tt)))
