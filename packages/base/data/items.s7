(define *item-catalog*
  (list
    (cons "medkit" '((stack . 5)))
    (cons "key-red" '((unique . #t)))))

(define (item-def id)
  (assoc id *item-catalog*))

(define (item-prop def key)
  (cond
    ((not def) #f)
    (else (let ((props (cdr def)))
            (cond
              ((assoc key props) => cdr)
              (else #f))))))

(define (item-stack-limit id)
  (let ((def (item-def id)))
    (or (item-prop def 'stack) 1)))

(define (item-unique? id)
  (let ((def (item-def id)))
    (eq? (item-prop def 'unique) #t)))
