(sprite-anim
  (clip "walk"
    (loop 1)
    (frame "A" 0.125)
    (frame "B" 0.125)
    (frame "C" 0.125)
    (frame "D" 0.125)
    (frame "E" 0.125)
    (frame "F" 0.125)
    (frame "G" 0.125)
  )
  (clip "fall"
    (loop 0)
    (frame "H" 0.1)
    (frame "I" 0.1)
    (frame "J" 0.1)
    (frame "K" 0.1)
    (frame "L" 0.1)
    (frame "M" 0.1)
    (frame "N" 0.1)
    (frame "O" 0.1)
    (frame "P" 0.1)
    (frame "Q" 0.1)
    (frame "R" 0.1)
    (frame "S" 0.1)
    (frame "T" 0.1)
    (frame "U" 0.1)
    (frame "V" 0.1)
    (frame "W" 0.1)
  )
)
