(define *inventory* '())

(define (inv-count id)
  (cond
    ((assoc id *inventory*) => cdr)
    (else 0)))

(define (inv-has id)
  (> (inv-count id) 0))

(define (inv-remove id lst)
  (cond
    ((null? lst) '())
    ((equal? (car (car lst)) id) (inv-remove id (cdr lst)))
    (else (cons (car lst) (inv-remove id (cdr lst))))))

(define (inv-set id count)
  (set! *inventory* (cons (cons id count) (inv-remove id *inventory*))))

(define (inv-add id amount)
  (cond
    ((not (item-def id))
     (format #t "inventory: unknown item ~a~%" id)
     #f)
    ((item-unique? id)
     (cond
       ((inv-has id)
        (format #t "inventory: already have unique ~a~%" id)
        #f)
       (else
        (inv-set id 1)
        (format #t "inventory: got unique ~a~%" id)
        #t)))
    (else
     (let* ((limit (item-stack-limit id))
            (have (inv-count id))
            (next (min limit (+ have amount))))
       (inv-set id next)
       (format #t "inventory: ~a now ~a/~a~%" id next limit)
       #t))))

(define (inv-print)
  (format #t "inventory: ~a~%" *inventory*))

(define (on-use-test thing-id)
  (format #t "used ~a~%" thing-id)
  (inv-print))

(define (on-use-medkit thing-id)
  (format #t "pickup medkit from ~a~%" thing-id)
  (inv-add "medkit" 1)
  (inv-print))

(define (on-use-key-red thing-id)
  (format #t "pickup key-red from ~a~%" thing-id)
  (inv-add "key-red" 1)
  (inv-print)
  (mover-set-locked "door-north-l" #f)
  (mover-set-locked "door-north-r" #f))

(define (on-use-mover-toggle thing-id)
  (mover-toggle thing-id))

(define (on-use-north-doors thing-id)
  (cond
    ((or (mover-locked? "door-north-l") (mover-locked? "door-north-r"))
     (cond
       ((inv-has "key-red")
        (mover-set-locked "door-north-l" #f)
        (mover-set-locked "door-north-r" #f)
        (mover-toggle-group "north-doors"))
       (else
        (format #t "north doors need key-red~%"))))
    (else
     (mover-toggle-group "north-doors"))))

(define (on-use-panel-east-door thing-id)
  (format #t "panel ~a opens door-east~%" thing-id)
  (mover-open "door-east"))

(define (on-crush-door mover-id victim-id)
  (format #t "crush ~a by ~a~%" victim-id mover-id))

(define (capture-mover-states)
  (let ((ids '("door-east" "door-north-l" "door-north-r"))
        (out '()))
    (for-each
     (lambda (id)
       (let ((st (mover-state id)))
         (cond
           (st (set! out (cons (cons id st) out))))))
     ids)
    out))

(define (restore-mover-states states)
  (for-each
   (lambda (entry)
     (let* ((id (car entry))
            (st (cdr entry))
            (open? (cond ((assoc 'open? st) => cdr) (else #f)))
            (progress (cond ((assoc 'progress st) => cdr) (else 0.0)))
            (locked? (cond ((assoc 'locked? st) => cdr) (else #f))))
       (mover-set-state id open? progress locked?)))
   states))

(define (lock-north-doors!)
  (mover-set-locked "door-north-l" #t)
  (mover-set-locked "door-north-r" #t))

(define (on-map-ready map-id reason)
  (format #t "map-ready ~a ~a~%" map-id reason)
  (cond
    ((equal? reason "load") #t)
    (else (lock-north-doors!))))
