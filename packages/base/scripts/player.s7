(define *flashlight-enabled* #f)

(define (prepare-first-person player-id)
  (fp-clear-socket "weapon")
  (fp-clear-socket "emission")
  (fp-attach-geo "weapon" "fp/stub" 0.22 -0.18 0.42 0.08 0.08 0.35)
  (fp-spawn-light "emission" 'spot 1.35 11.0 0.55 1.0 0.96 0.88 0.0 0.0 0.12)
  (fp-set-rad-tint #t)
  (fp-set-shading #t)
  (set! *flashlight-enabled* #f)
  (fp-set-light-enabled "emission" #f))

(define (on-action-flashlight)
  (set! *flashlight-enabled* (not *flashlight-enabled*))
  (fp-set-light-enabled "emission" *flashlight-enabled*))
