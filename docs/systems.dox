/**
 * @addtogroup input_systems
 * @{
 *
 * @section sys_PollInput PollInput
 * Phase: `PreUpdate`. Samples device bindings into @ref slopengine::InputState.
 * Defined in `input/input_module.cpp`.
 *
 * @section sys_DispatchPackageActions DispatchPackageActions
 * Phase: `OnUpdate`. Runs package Scheme handlers for pressed actions.
 * Defined in `input/input_module.cpp`.
 *
 * @}
 */

/**
 * @addtogroup ui_systems
 * @{
 *
 * @section sys_HandleUiActions HandleUiActions
 * Phase: `PreUpdate`. Opens/closes console, pause, and other UI from input actions.
 * Defined in `ui/ui_module.cpp`.
 *
 * @}
 */

/**
 * @addtogroup physics_systems
 * @{
 *
 * @section sys_CharacterMotorInput CharacterMotorInput
 * Phase: `PreUpdate`. Copies wish velocity from input onto @ref slopengine::CharacterMotor.
 * Defined in `physics/physics_module.cpp`.
 *
 * @section sys_PhysicsStep PhysicsStep
 * Phase: `OnUpdate`. Steps Jolt and syncs character pose back to the camera/entity.
 * Defined in `physics/physics_module.cpp`.
 *
 * @section sys_TriggerOverlap TriggerOverlap
 * Phase: `OnUpdate`. Detects @ref slopengine::TriggerVolume enter/exit and calls Scheme.
 * Defined in `physics/physics_module.cpp`.
 *
 * @section sys_UpdateFaceTouch UpdateFaceTouch
 * Phase: `OnUpdate`. Detects @ref slopengine::FaceTouch enter/exit on CSG faces and calls Scheme.
 * Defined in `physics/physics_module.cpp`.
 *
 * @section sys_MotoredBodyIntegrate MotoredBodyIntegrate
 * Phase: `OnUpdate`. Integrates @ref slopengine::MotoredBody projectiles against static hulls and actors, firing impacts.
 * Defined in `physics/motored_body.cpp`.
 *
 * @section sys_RigidMoverAdvance RigidMoverAdvance
 * Phase: `PreUpdate`. Advances @ref slopengine::RigidMover progress toward its target and syncs the kinematic body.
 * Defined in `physics/rigid_mover.cpp`.
 *
 * @section sys_RigidMoverCharacterResolve RigidMoverCharacterResolve
 * Phase: `OnUpdate`. Shoves/crushes characters caught in a moving @ref slopengine::RigidMover and calls `on-crush`.
 * Defined in `physics/rigid_mover.cpp`.
 *
 * @section sys_RigidMoverRadTint RigidMoverRadTint
 * Phase: `PreUpdate`. Samples the bake tint for a @ref slopengine::RigidMover model at its closed pose.
 * Defined in `physics/rigid_mover.cpp`.
 *
 * @section sys_WorldModelLightTint WorldModelLightTint
 * Phase: `PreUpdate`. Samples the bake tint for world-space models that are not movers, lightmapped map geo, or view-space.
 * Defined in `physics/rigid_mover.cpp`.
 *
 * @section sys_RigidMoverOnRemove RigidMoverOnRemove
 * Observer: `OnRemove` on @ref slopengine::RigidMover. Destroys the entity's kinematic body.
 * Defined in `physics/rigid_mover.cpp`.
 *
 * @section sys_SightScan SightScan
 * Phase: `OnUpdate`. Round-robins @ref slopengine::ActorSight linescans and calls `on-sight` on newly visible targets.
 * Defined in `physics/sight_module.cpp`.
 *
 * @}
 */

/**
 * @addtogroup audio_systems
 * @{
 *
 * @section sys_AudioSourceAutoplay AudioSourceAutoplay
 * Phase: `OnUpdate`. Starts @ref slopengine::AudioSource voices marked `autoplay`.
 * Defined in `audio/audio_module.cpp`.
 *
 * @section sys_Sync3dAudio Sync3dAudio
 * Phase: `OnUpdate`. Syncs listener and spatial source poses with the audio backend.
 * Defined in `audio/audio_module.cpp`.
 *
 * @section sys_AudioSourceOnRemove AudioSourceOnRemove
 * Observer: `OnRemove` on @ref slopengine::AudioSource. Stops the voice when the component is removed.
 * Defined in `audio/audio_module.cpp`.
 *
 * @}
 */

/**
 * @addtogroup camera_systems
 * @{
 *
 * @section sys_FirstPersonController FirstPersonController
 * Phase: `PreUpdate`. Applies look (and free-move when not physics-driven) to the player @ref slopengine::Lens.
 * Defined in `camera/camera_module.cpp`.
 *
 * @}
 */

/**
 * @addtogroup interact_systems
 * @{
 *
 * @section sys_UpdateInteractionTarget UpdateInteractionTarget
 * Phase: `PreUpdate`. Ray/aim pick of the best @ref slopengine::Interactable into @ref slopengine::InteractionTarget.
 * Defined in `interact/interact_module.cpp`.
 *
 * @section sys_HandleInteractAction HandleInteractAction
 * Phase: `PreUpdate`. On Interact, invokes the target's Scheme `on-use` handler.
 * Defined in `interact/interact_module.cpp`.
 *
 * @}
 */

/**
 * @addtogroup script_systems
 * @{
 *
 * @section sys_FlushThingDespawns FlushThingDespawns
 * Phase: `OnUpdate`. Destroys entities queued for despawn by the thing runtime API.
 * Defined in `script/thing_script.cpp`.
 *
 * @section sys_TimedDespawnAdvance TimedDespawnAdvance
 * Phase: `OnUpdate`. Counts down `TimedDespawn` and queues the entity for despawn at zero.
 * Defined in `script/thing_script.cpp`.
 *
 * @}
 */

/**
 * @addtogroup particles_systems
 * @{
 *
 * @section sys_ParticleSystemUpdate ParticleSystemUpdate
 * Phase: `OnUpdate`. Emits, simulates, and despawns particles for every @ref slopengine::ParticleSystemInstance.
 * Defined in `particles/particle_module.cpp`.
 *
 * @}
 */

/**
 * @addtogroup navigation_systems
 * @{
 *
 * @section sys_NavUpdate NavUpdate
 * Phase: `OnUpdate`. Replans @ref slopengine::NavigationAgent paths toward their goal and steers the character motor.
 * Defined in `navigation/nav_module.cpp`.
 *
 * @}
 */

/**
 * @addtogroup render_systems
 * @{
 *
 * @section sys_ApplySpin ApplySpin
 * Phase: `OnUpdate`. Rotates entities that have @ref slopengine::Spin.
 * Defined in `render/animation_systems.cpp`.
 *
 * @section sys_CallSchemeTick CallSchemeTick
 * Phase: `OnUpdate`. Invokes the package Scheme per-frame tick hook.
 * Defined in `render/animation_systems.cpp`.
 *
 * @section sys_AdvanceAnimationPlayer AdvanceAnimationPlayer
 * Phase: `OnUpdate`. Advances @ref slopengine::AnimationPlayer and skins @ref slopengine::Model3D.
 * Defined in `render/animation_systems.cpp`.
 *
 * @section sys_AnimationClipFlipTest AnimationClipFlipTest
 * Phase: `PostUpdate`. Demo helper that flips clips via @ref slopengine::AnimationClipFlipTest.
 * Defined in `render/animation_systems.cpp`.
 *
 * @section sys_AdvanceMaterialAnim AdvanceMaterialAnim
 * Phase: `OnUpdate`. Advances material animation clocks and applies the resulting texture frames.
 * Defined in `render/material_anim.cpp`.
 *
 * @section sys_AdvanceSpriteAnimator AdvanceSpriteAnimator
 * Phase: `OnUpdate`. Advances @ref slopengine::SpriteAnimator into @ref slopengine::SpriteInstance.
 * Defined in `render/sprite_animator_system.cpp`.
 *
 * @section sys_SyncSpriteOverlayViewOffset SyncSpriteOverlayViewOffset
 * Phase: `OnUpdate`. Copies a @ref slopengine::SpriteOverlay host's view offset/scale/rotation onto the overlay's @ref slopengine::ViewSprite.
 * Defined in `render/sprite_animator_system.cpp`.
 *
 * @section sys_SyncSpriteOverlayFacing SyncSpriteOverlayFacing
 * Phase: `OnUpdate`. Copies a world-space @ref slopengine::SpriteOverlay host's facing yaw onto the overlay.
 * Defined in `render/sprite_animator_system.cpp`.
 *
 * @section sys_DespawnFinishedSpriteOverlays DespawnFinishedSpriteOverlays
 * Phase: `OnUpdate`. Destroys non-looping @ref slopengine::SpriteOverlay entities once their clip finishes.
 * Defined in `render/sprite_animator_system.cpp`.
 *
 * @section sys_UpdateGlobalTransforms UpdateGlobalTransforms
 * Phase: `OnUpdate`. Recomputes @ref slopengine::GlobalTransformation from the hierarchy.
 * Defined in `render/animation_systems.cpp`.
 *
 * @section sys_StartDrawing StartDrawing
 * Phase: `PostUpdate`. Begins the raylib frame (`BeginDrawing`).
 * Defined in `render/render_module.cpp`.
 *
 * @section sys_UpdateFirstPersonScene UpdateFirstPersonScene
 * Phase: `PostUpdate`. Updates eye-space sockets and viewmodel transforms.
 * Defined in `render/render_module.cpp`.
 *
 * @section sys_LensWorld LensWorld
 * Phase: `PostUpdate`. Renders the world pass from a @ref slopengine::WorldSpace @ref slopengine::Lens.
 * Defined in `render/render_module.cpp`.
 *
 * @section sys_MenuTitleOverlay MenuTitleOverlay
 * Phase: `PostUpdate`. Draws the menu background image and title canvas while in a menu state.
 * Defined in `render/render_module.cpp`.
 *
 * @section sys_ImGuiOverlay ImGuiOverlay
 * Phase: `PostUpdate`. Draws ImGui UI overlays after the 3D pass.
 * Defined in `render/render_module.cpp`.
 *
 * @section sys_EndDrawing EndDrawing
 * Phase: `PostUpdate`. Ends the raylib frame (`EndDrawing`).
 * Defined in `render/render_module.cpp`.
 *
 * @}
 */
