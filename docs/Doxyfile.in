PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@SLOPENGINE_DOCS_VERSION@ (@SLOPENGINE_DOCS_GIT_COMMIT@)"
PROJECT_BRIEF          = "Engine Documentation"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIRECTORY@"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = "@DOXYGEN_INPUT_DIRECTORY@" \
                         "@CMAKE_SOURCE_DIR@/docs"
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.md *.dox *.png
EXCLUDE                =
EXCLUDE_PATTERNS       =

OPTIMIZE_OUTPUT_FOR_C  = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
SORT_MEMBER_DOCS       = YES
INLINE_SIMPLE_STRUCTS  = YES
INLINE_GROUPED_CLASSES = YES
IMAGE_PATH = ../docs

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
SHOW_INCLUDE_FILES     = YES

DISABLE_INDEX          = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES

HTML_COLORSTYLE_HUE    = 210
HTML_COLORSTYLE_SAT    = 45
HTML_COLORSTYLE_GAMMA  = 100
HTML_CODE_FOLDING      = YES
HTML_EXTRA_STYLESHEET  = "@CMAKE_CURRENT_SOURCE_DIR@/docs/style.css"
HTML_EXTRA_FILES       = "@CMAKE_CURRENT_SOURCE_DIR@/docs/engine-scheme-fns.js"
HTML_HEADER            = "@CMAKE_CURRENT_SOURCE_DIR@/docs/header.html"
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO

QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

USE_MDFILE_AS_MAINPAGE = "@DOXYGEN_MAINPAGE@"

