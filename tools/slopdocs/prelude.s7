(define (sd-split-attrs who args)
  (let loop ((rest args) (attrs '()))
    (if (and (pair? rest) (keyword? (car rest)))
        (if (null? (cdr rest))
            (error 'slopdocs "~A: attribute ~A has no value" who (car rest))
            (loop (cddr rest) (cons (list (keyword->symbol (car rest)) (cadr rest)) attrs)))
        (cons (reverse attrs) rest))))

(define (sd-splice children)
  (cond ((null? children) '())
        ((not (car children)) (sd-splice (cdr children)))
        ((null? (car children)) (sd-splice (cdr children)))
        ((and (pair? (car children)) (pair? (caar children)))
         (append (sd-splice (car children)) (sd-splice (cdr children))))
        (else (cons (car children) (sd-splice (cdr children))))))

(define (sd-make tag attrs children)
  (if (null? attrs)
      (cons tag children)
      (cons tag (cons (cons '@ attrs) children))))

(define (sd-node tag args)
  (let ((split (sd-split-attrs tag args)))
    (sd-make tag (car split) (sd-splice (cdr split)))))

(define (sd-take-string who split)
  (let ((rest (cdr split)))
    (if (and (pair? rest) (string? (car rest)))
        (car rest)
        (error 'slopdocs "~A: expected a string, got ~S" who (if (pair? rest) (car rest) '())))))

(define (p . args) (sd-node 'p args))
(define (em . args) (sd-node 'em args))
(define (strong . args) (sd-node 'strong args))
(define (kbd . args) (sd-node 'kbd args))
(define (ul . args) (sd-node 'ul args))
(define (ol . args) (sd-node 'ol args))
(define (item . args) (sd-node 'item args))
(define (table . args) (sd-node 'table args))
(define (header . args) (sd-node 'header args))
(define (row . args) (sd-node 'row args))
(define (cell . args) (sd-node 'cell args))
(define (note . args) (sd-node 'note args))
(define (tip . args) (sd-node 'tip args))
(define (warning . args) (sd-node 'warning args))
(define (quote-block . args) (sd-node 'quote-block args))
(define (hr . args) (sd-node 'hr args))
(define (br . args) (sd-node 'br args))
(define (html . args) (sd-node 'html args))

(define (section . args)
  (let* ((split (sd-split-attrs 'section args))
         (title (sd-take-string 'section split)))
    (sd-make 'section
             (append (car split) (list (list 'title title)))
             (sd-splice (cddr split)))))

(define (code . args)
  (let* ((split (sd-split-attrs 'code args))
         (rest (cdr split)))
    (if (and (pair? rest) (symbol? (car rest)))
        (sd-make 'code
                 (append (car split) (list (list 'lang (symbol->string (car rest)))))
                 (sd-splice (cdr rest)))
        (sd-make 'code (car split) (sd-splice rest)))))

(define (image . args)
  (let* ((split (sd-split-attrs 'image args))
         (rest (cdr split)))
    (if (not (and (pair? rest) (string? (car rest))))
        (error 'slopdocs "image: expected a source path"))
    (let ((src (car rest))
          (alt (if (and (pair? (cdr rest)) (string? (cadr rest))) (cadr rest) ""))
          (caption (if (and (pair? (cdr rest)) (string? (cadr rest))) (cddr rest) (cdr rest))))
      (sd-make 'image
               (append (car split) (list (list 'src src) (list 'alt alt)))
               (sd-splice caption)))))

(define (link . args)
  (let* ((split (sd-split-attrs 'link args))
         (href (sd-take-string 'link split)))
    (sd-make 'link (append (car split) (list (list 'href href))) (sd-splice (cddr split)))))

(define (page-ref . args)
  (let* ((split (sd-split-attrs 'page-ref args))
         (id (sd-take-string 'page-ref split)))
    (sd-make 'page-ref (append (car split) (list (list 'page id))) (sd-splice (cddr split)))))

(define (ref . args)
  (let* ((split (sd-split-attrs 'ref args))
         (name (sd-take-string 'ref split)))
    (sd-make 'ref (append (car split) (list (list 'name name))) '())))

(define (term . args)
  (let* ((split (sd-split-attrs 'term args))
         (name (sd-take-string 'term split)))
    (sd-make 'term (append (car split) (list (list 'term name))) (sd-splice (cddr split)))))

(define (dl . args) (sd-node 'dl args))

(define (page . args)
  (let* ((split (sd-split-attrs 'page args))
         (id (sd-take-string 'page split))
         (rest (cddr split)))
    (if (not (and (pair? rest) (string? (car rest))))
        (error 'slopdocs "page ~S: expected a title" id))
    (sd-register-page
      (sd-make 'page
               (append (car split) (list (list 'id id) (list 'title (car rest))))
               (sd-splice (cdr rest))))))
